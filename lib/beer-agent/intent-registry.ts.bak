// ── Registration functions ──

/**
 * Register a new intent or replace an existing one.
 */
export function registerIntent(def: IntentDefinition): void {
  const idx = INTENT_REGISTRY.findIndex((d) => d.id === def.id);
  if (idx >= 0) {
    INTENT_REGISTRY[idx] = def;
  } else {
    INTENT_REGISTRY.push(def);
  }
}

/**
 * Remove an intent from the registry.
 */
export function unregisterIntent(id: BeerIntent): boolean {
  const idx = INTENT_REGISTRY.findIndex((d) => d.id === id);
  if (idx >= 0) {
    INTENT_REGISTRY.splice(idx, 1);
    return true;
  }
  return false;
}

/**
 * Get an intent definition by ID.
 */
export function getIntent(id: BeerIntent): IntentDefinition | undefined {
  return INTENT_REGISTRY.find((d) => d.id === id);
}

/**
 * Get all registered intents (sorted by priority).
 */
export function getAllIntents(): IntentDefinition[] {
  return [...INTENT_REGISTRY];
}

// ── Compile regex helpers ──

function compileRegex(pattern: string): RegExp {
  try {
    return new RegExp(pattern, "i");
  } catch {
    return /(?!)/; // never matches
  }
}

// ── Intent testing (dry-run) ──

/**
 * Test intent classification without calling the full pipeline.
 * Used by the Debug Intent Test panel and /api/intent-test.
 */
export function testIntent(
  text: string,
  hasImage: boolean,
  options?: {
    hasActiveMenu?: boolean;
    turnsSinceMenu?: number;
    activeMenuCandidateCount?: number;
    threshold?: number;
    multiIntentGap?: number;
  },
): IntentTestResult {
  const threshold = options?.threshold ?? 0.7;
  const multiIntentGap = options?.multiIntentGap ?? 0.15;
  const hasActiveMenu = options?.hasActiveMenu ?? false;
  const turnsSinceMenu = options?.turnsSinceMenu ?? 999;
  const activeMenuCandidateCount = options?.activeMenuCandidateCount ?? 0;

  // Collect all matching rules across all intents
  const matches: Array<{
    intent: BeerIntent;
    label: string;
    confidence: number;
    ruleIndex: number;
  }> = [];

  for (const def of INTENT_REGISTRY) {
    // Skip intents that require an active menu if none exists
    if (def.requiresActiveMenu && (!hasActiveMenu || turnsSinceMenu >= 30 || activeMenuCandidateCount === 0)) {
      continue;
    }

    for (let ri = 0; ri < def.rules.length; ri++) {
      const rule = def.rules[ri];
      // Check image requirement
      if (rule.requiresImage && !hasImage) continue;

      // Compile and test regex
      const regex = compileRegex(rule.pattern);
      if (regex.test(text) && rule.confidence >= threshold) {
        matches.push({
          intent: def.id,
          label: def.label,
          confidence: rule.confidence,
          ruleIndex: ri,
        });
        break; // Only first matching rule per intent
      }
    }
  }

  // Sort by confidence descending
  matches.sort((a, b) => b.confidence - a.confidence);

  if (matches.length === 0) {
    return {
      input: { text, hasImage },
      matched: [],
      primary: "unclear",
      isMultiIntent: false,
      source: "no_match",
    };
  }

  const primary = matches[0].intent;

  // Multi-intent: if 2+ intents with confidence gap < multiIntentGap
  const isMulti =
    matches.length >= 2 &&
    (matches[0].confidence - matches[1].confidence) <= multiIntentGap;

  return {
    input: { text, hasImage },
    matched: matches,
    primary,
    isMultiIntent: isMulti,
    source: "rule",
  };
}
