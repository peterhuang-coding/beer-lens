# OpenRouter model provider
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_TITLE=Beer Lens

# Optional: replace the built-in OpenRouter/mock provider with your own API.
# If set, /api/agent forwards requests there instead of using OpenRouter.
BEER_AGENT_API_URL=
BEER_AGENT_API_KEY=

# Optional: Feishu/Lark bot channel
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ── Untappd crawler (lib/beer-agent/beer-db/crawlers/untappd.ts) ──
# Optional HTTP proxy (e.g. http://user:pass@host:8080 — credentials are
# stripped from logs; only host:port is recorded).
UNTAPPD_PROXY_URL=
# Optional sticky User-Agent (overrides random UA pool). When unset the
# crawler picks one UA and reuses it for the whole crawl session.
UNTAPPD_USER_AGENT=
# Optional session cookie (sent verbatim in `Cookie:` header). Use this
# when you have an authenticated Untappd session.
UNTAPPD_COOKIE=
# Optional per-request timeout in ms (default 20000).
UNTAPPD_TIMEOUT_MS=20000

# ── RateBeer crawler (lib/beer-agent/beer-db/crawlers/ratebeer.ts) ──
# Default source for ratebeer updates. Adapter is selected automatically
# from the URL hostname; data kind=kaggle|http-url|file is recorded in
# `source` + `source_checksum` columns for cross-source isolation.
RATEBEER_SOURCE_URL=
# When RATEBEER_SOURCE_URL is empty and RATEBEER_SOURCE_FILE is set, the
# crawler stages the local CSV/ZIP instead of downloading.
RATEBEER_SOURCE_FILE=

# ── Flickr / Wikimedia image crawler (lib/beer-agent/beer-db/crawlers/flickr.ts) ──
# Optional. When unset, only Wikimedia Commons is queried (no key needed).
# When set and Wikimedia yields 0 results, the crawler falls back to the
# official Flickr REST API. Used for collecting label images only — never
# writes to beer tables.
FLICKR_API_KEY=

# ── Wikimedia Commons polite UA ──
# Optional but recommended. Use a UA that includes contact info
# (required by Wikimedia API etiquette). Default shown below; replace
# `contact@example.com` with a real address before production use.
WIKIMEDIA_USER_AGENT=BeerLens/0.1 (https://localhost:3000)
