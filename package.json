{
  "name": "beer-researcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "demo": "node scripts/beer-agent-demo.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mts",
    "test:agent": "node scripts/run-agent-regression.mjs",
    "raw:crawl": "node scripts/crawl-raw-sources.mjs",
    "raw:tasks": "node scripts/generate-raw-tasks.mjs",
    "raw:export": "node scripts/export-raw-dataset.mjs",
    "raw:collect": "node scripts/collect-queries.mjs",
    "raw:cron": "node scripts/raw-cron.mjs",
    "benchmark:images": "node scripts/run-image-benchmark.mjs",
    "crawl": "npx tsx scripts/crawl-all.mjs",
    "crawl:cn": "npx tsx scripts/crawl-all.mjs --cn-only",
    "crawl:untappd": "npx tsx scripts/crawl-all.mjs --source untappd --country CN",
    "cli": "node scripts/cli.mjs",
    "skill:decide": "node skills/beer-lens/scripts/decide-menu.mjs",
    "crawl:test": "node --experimental-strip-types --test tests/crawler-cli.test.mts",
    "skill-toggle:detail:test": "node --experimental-strip-types --test tests/skill-toggle-detail.test.mts",
    "harness:dashboard": "node scripts/build-harness-dashboard.mjs",
    "selector-probe": "node scripts/probe-selectors.mjs",
    "selector-drift:dashboard": "node scripts/build-selector-drift-dashboard.mjs",
    "import-untappd-csv": "node scripts/import-untappd-csv.mjs",
    "agent": "node scripts/agent.mjs",
    "crawl:round": "node scripts/always-on-crawler.mjs",
    "inspector": "node scripts/skill-inspector.mjs",
    "hub:serve": "node scripts/skill-hub-server.mjs",
    "crawl:cli": "node --experimental-strip-types bin/beer-lens-crawl.mjs",
    "check": "npm test && npm run test:data && npm run typecheck && npm run build",
    "test:data": "python3 -m unittest discover -s tests/python",
    "data:assets": "python3 scripts/beer-data-assets.py"
  },
  "bin": {
    "beer-lens": "scripts/cli.mjs",
    "beer-lens-crawl": "./bin/beer-lens-crawl.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^8.3.0",
    "untappd-node": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.47.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
