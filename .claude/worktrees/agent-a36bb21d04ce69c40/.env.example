# OpenRouter model provider
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_TITLE=Beer Lens

# Optional: replace the built-in OpenRouter/mock provider with your own API.
# If set, /api/agent forwards requests there instead of using OpenRouter.
BEER_AGENT_API_URL=
BEER_AGENT_API_KEY=

# Optional: Feishu/Lark bot channel
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
